# Django Settings
DJANGO_SECRET_KEY=your-secure-random-secret-key-here
DJANGO_SETTINGS_MODULE=config.settings.production
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# Database Configuration (PostgreSQL on Render)
DATABASE_URL=postgresql://user:password@host:port/database_name

# Superuser Initial Credentials (Used by create_default_admin)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@blueteamers.io
DJANGO_SUPERUSER_PASSWORD=your-super-strong-admin-password-here

# CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:8081,http://localhost:3000

# Redis / Channels (Optional)
REDIS_URL=redis://red-xxxx:6379
